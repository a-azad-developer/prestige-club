# Ensure shell scripts always use LF line endings (required for Alpine Linux)
docker-entrypoint.sh text eol=lf
*.sh text eol=lf

# Normalize all other source files to LF
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
